# Spør om nettolønn, regner resten selv. Oppgir alle avgifter og skatt man betaler,
# viser også skattesatsen og lønn og månedslønn 

# Lager en funksjon for skattekalkulatoren
def skattekalkulator():
    def skattegrenser(brutto):
        grenser = [226100, 318300, 725050, 980100, 1467200]
        satser = [0.017, 0.04, 0.137, 0.168, 0.178]

        skatt = 0
        for i, sats in enumerate(satser):
            nedre_grense = grenser[i]
            øvre_grense = grenser[i + 1] if i + 1 < len(grenser) else brutto
            skatt += max(0, min(brutto, øvre_grense) - nedre_grense) * sats

        return skatt

    # Start
    # Definerer faste verdier
    alminnelig_skatt_prosent = 0.22
    trygd_eavgift_prosent = 0.076
    minstefradrag_prosent = 0.46
    minstefradrag_maks = 90000
    personfradrag = 100000


    # Starter kalkulatoren og spør om brutto årsinntekt
    dekorasjon = "¨" * 60
    dekorasjon2 = "¤" * 60
    print(dekorasjon)
    print("Velkommen til skattekalkulatoren!")
    print(dekorasjon)
    # Spør bruker om brutto årsinntekt
    brutto = float(input("Skriv inn brutto årsinntekt: "))
    print(dekorasjon)

    # Spør om bruker har fradrag.
    har_fradrag = input("Har du fradrag? (ja/nei): ").lower()
    print(dekorasjon2)
    if har_fradrag == "ja":
        fradrag = float(input("Skriv inn fradrag i kroner: "))
    else:
        fradrag = 0

    # Finn riktig skatteprosent fra skattegrenser-funksjonen
    trinnskatt = skattegrenser(brutto)

    # Beregner skatt på brutto årsinntekt
    skatt = trinnskatt
    netto = brutto - skatt
    skatteprosent = skatt / brutto * 100 if brutto else 0

    # Beregner minstefradrag
    minstefradrag = brutto * 0.46
    minstefradrag = min(minstefradrag, minstefradrag_maks)

    # Beregner alminnelig inntekt
    alminnelig_inntekt = brutto - minstefradrag - personfradrag
    alminnelig_inntekt = alminnelig_inntekt - fradrag
    alminnelig_inntekt = max(alminnelig_inntekt, 0)



    # Viser resultatene
    print(dekorasjon)
    print("Resultater")
    print(dekorasjon)
    print(f"Brutto årslønn: {brutto:.2f} kr")
    print(f"Fradrag: {fradrag:.2f} kr")
    print(f"Skatteprosent: {skatteprosent:.2f} %")
    print(f"Skatt: {skatt:.2f} kr")
    print(f"Trinnskatt: {trinnskatt:.2f} kr")
    print(dekorasjon)
    print(f"Netto årslønn: {netto:.2f} kr")
    print(f"Omtrentlig månedslønn etter skatt: {netto / 12:.2f} kr")
    print(dekorasjon2)

# Kjører funksjonen for å starte skattekalkulatoren
