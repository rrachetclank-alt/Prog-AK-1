# Oppg7 Skattekalkulator Jonas
# Spør om nettolønn, regner resten selv. Oppgir alle avgifter og skatt man betaler,
# viser også skattesatsen og lønn og månedslønn 

# Lager en funksjon for skattekalkulatoren
def skattekalkulator():
    def skattegrenser(brutto):
        # Grenser for skatteprosenter og trinnskatt
        if brutto <= 226100:
            return 0
        elif brutto <= 318300:
            return (brutto - 226100) * 0.017
        elif brutto <= 725050:
            return (318300 - 226100) * 0.017 + (brutto - 318300) * 0.04
        elif brutto <= 980100:
            return (
                (318300 - 226100) * 0.017
                + (725050 - 318300) * 0.04
                + (brutto - 725050) * 0.137
            )
        elif brutto <= 1467200:
            return (
                (318300 - 226100) * 0.017
                + (725050 - 318300) * 0.04
                + (980100 - 725050) * 0.137
                + (brutto - 980100) * 0.168
            )
        else:
            return (
                (318300 - 226100) * 0.017
                + (725050 - 318300) * 0.04
                + (980100 - 725050) * 0.137
                + (1467200 - 980100) * 0.168
                + (brutto - 1467200) * 0.178
            )

    # Start
    # Starter kalkulatoren og spør om brutto årsinntekt
    dekorasjon = "¨" * 60
    print(dekorasjon)
    print("Velkommen til skattekalkulatoren!")
    print(dekorasjon)
    brutto = float(input("Skriv inn brutto årsinntekt: "))

    # Finn riktig skatteprosent fra skattegrenser-funksjonen
    skatteprosent = skattegrenser(brutto)

    # Beregner skatt på brutto årsinntekt
    skatt = brutto * skatteprosent / 100
    netto = brutto - skatt

    # Viser resultatene
    print(dekorasjon)
    print("Resultater")
    print(dekorasjon)
    print(f"Brutto årslønn: {brutto:.2f} kr")
    print(f"Skatteprosent: {skatteprosent} %")
    print(f"Skatt: {skatt:.2f} kr")
    print(dekorasjon)
    print(f"Netto årslønn: {netto:.2f} kr")
    print(f"Omtrentlig månedslønn etter skatt: {netto / 12:.2f} kr")
    print(dekorasjon)

# Kjører funksjonen for å starte skattekalkulatoren
skattekalkulator()